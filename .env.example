# Copie este arquivo para .env somente no computador local.
# Nunca envie .env, senhas ou DATABASE_URL real ao GitHub.
NODE_ENV=development
PORT=3000

# Substitua por uma chave aleatoria de pelo menos 32 caracteres.
JWT_SECRET=substitua_esta_chave_por_um_valor_aleatorio_com_32_caracteres

# Conta administrativa inicial. Senha: minimo de 12 caracteres.
ADMIN_EMAIL=admin@urbanlink.com
ADMIN_PASSWORD=substitua_por_uma_senha_forte_com_12_ou_mais_caracteres

# Desenvolvimento local simples: SQLite em arquivo.
USE_SQLITE=true
SQLITE_PATH=urbanlink_db.sqlite

# Alteracao automatica de tabelas: evite em producao.
DB_SYNC_ALTER=false

# Producao no Supabase: use a URL privada do pooler em Vercel > Environment Variables.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres

# Alternativa local opcional: MySQL (so se USE_SQLITE=false e DATABASE_URL ausente).
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=urbanlink_db
# DB_USER=root
# DB_PASSWORD=
